// @match pełnomocnictwo(?: procesowe| ogólne| szczególne)?
// @normalize mocodawca.*.data.krs digits
// @normalize mocodawca.*.data.nip digits
// @normalize pelnomocnicy.*.pesel digits
{
  // Mocodawca – podmiot udzielający pełnomocnictwa. może być więcej niż 1 (konsorcjum wspólnie)
  // Zachowaj kolejność mocodawców z dokumentu.
  "mocodawca": [
    {
      "data": {
        // Imię i nazwisko mocodawcy w mianowniku, jeśli jest osobą fizyczną. Przy różnych formach nazwiska wybierz znacznik z imiennej rubryki lub podpisu tej osoby.
        // W przypadku osoby prawnej: null.
        // Dla JDG wybierz osobę prowadzącą działalność. Pełną nazwę firmy wpisz w polu nazwa.
        "imie_nazwisko": null,

        // Numer KRS mocodawcy będącego osobą prawną.
        "krs": "0000244633",

        // Pełna nazwa mocodawcy.
        "nazwa": "FAMBUD",

        // Numer NIP mocodawcy.
        "nip": "8361772283",

        // Typ mocodawcy: "osoba_prawna" lub "osoba_fizyczna".
        // JDG to osoba fizyczna.
        "typ": "osoba_prawna"
      },

      // Osoby podpisujące w imieniu mocodawcy.
      // Zachowaj kolejność podpisów i przypisz je właściwemu mocodawcy.
      "podpisujacy": [
        {
          "imie_nazwisko": "Paweł Podolski"
        }
      ]
    }
  ],
// @singleton pelnomocnicy pełnomocnik
  // Osoby otrzymujące pełnomocnictwo.
  "pelnomocnicy": [
    {
      // Imię i nazwisko pełnomocnika w mianowniku.
      "imie_nazwisko": "Krystyna Mazowiecka",
      // Wybierz PESEL tej osoby. Numer wpisu zawodowego ma własną etykietę.
      // Skopiuj wartość po etykiecie „PESEL” przy tej osobie. Jeśli brak tej etykiety, zwróć null.
      // Wartość PESEL w wyniku ma być tekstem zachowującym wszystkie cyfry, w tym zera wiodące.
      "pesel": 85120133547
    }
  ]
}
